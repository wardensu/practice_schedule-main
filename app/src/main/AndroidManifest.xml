<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PracticeSchedule">

        <!-- Стартовый экран: intent-filter с MAIN и LAUNCHER,
             поэтому значок приложения открывает именно его.
             Экран доступен системе снаружи, значит exported="true". -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Внутренние экраны: открываются только явными Intent изнутри
             приложения, поэтому exported="false".
             Незарегистрированный здесь экран запустить нельзя —
             startActivity() завершится с ActivityNotFoundException. -->
        <activity
            android:name=".ScheduleActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".LessonActivity"
            android:exported="false"
            android:parentActivityName=".ScheduleActivity" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

    </application>

</manifest>
