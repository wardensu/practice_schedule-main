<?xml version="1.0" encoding="utf-8"?>
<!--
    Экран 3 — карточка дисциплины и преподавателя.
    Корневой контейнер: RelativeLayout. Значок привязан к левому верхнему
    углу, названия — относительно значка, кнопка «Назад» прижата к низу
    экрана (layout_alignParentBottom), сведения расположены между ними.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lessonRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="@dimen/screen_padding">

    <!-- Значок вида занятия: левый верхний угол -->
    <ImageView
        android:id="@+id/ivLessonType"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:background="@drawable/bg_icon_circle"
        android:padding="@dimen/space_medium"
        android:contentDescription="@string/lesson_icon_description" />

    <!-- Название дисциплины: справа от значка -->
    <TextView
        android:id="@+id/tvSubject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/ivLessonType"
        android:layout_alignTop="@id/ivLessonType"
        android:layout_marginStart="@dimen/space_medium"
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <!-- Вид занятия: под названием, по той же левой границе -->
    <TextView
        android:id="@+id/tvType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvSubject"
        android:layout_alignStart="@id/tvSubject"
        android:layout_marginTop="@dimen/space_small"
        android:textSize="@dimen/text_subtitle"
        android:textColor="@color/accent" />

    <!-- Кнопка «Назад» прижата к нижнему краю экрана -->
    <Button
        android:id="@+id/btnBackLesson"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_alignParentBottom="true"
        android:text="@string/btn_back" />

    <!-- Область сведений: растянута между значком и кнопкой.
         ScrollView прозрачен, поэтому белая карточка внутри занимает
         ровно столько места, сколько нужно её содержимому, а при нехватке
         высоты экрана содержимое прокручивается. -->
    <ScrollView
        android:id="@+id/svDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/ivLessonType"
        android:layout_above="@id/btnBackLesson"
        android:layout_marginTop="@dimen/space_large"
        android:layout_marginBottom="@dimen/space_medium">

    <LinearLayout
        android:id="@+id/llDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="@dimen/screen_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lesson_teacher_label"
            style="@style/FieldLabel" />

        <TextView
            android:id="@+id/tvTeacher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_primary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_medium"
            android:layout_marginBottom="@dimen/space_medium"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lesson_room_label"
            style="@style/FieldLabel" />

        <TextView
            android:id="@+id/tvRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_primary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_medium"
            android:layout_marginBottom="@dimen/space_medium"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lesson_time_label"
            style="@style/FieldLabel" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_primary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_medium"
            android:layout_marginBottom="@dimen/space_medium"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lesson_group_label"
            style="@style/FieldLabel" />

        <TextView
            android:id="@+id/tvLessonGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_primary" />
    </LinearLayout>
    </ScrollView>
</RelativeLayout>
