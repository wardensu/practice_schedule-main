<?xml version="1.0" encoding="utf-8"?>
<!--
    Правила резервного копирования для Android 11 и ниже.
    Приложение не хранит пользовательских данных (расписание задано в коде),
    поэтому копировать нечего: исключаем каталог настроек целиком.
-->
<full-backup-content>
    <exclude
        domain="sharedpref"
        path="." />
</full-backup-content>
