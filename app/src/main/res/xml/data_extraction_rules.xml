<?xml version="1.0" encoding="utf-8"?>
<!--
    Правила переноса и резервного копирования для Android 12 и выше
    (атрибут android:dataExtractionRules).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="." />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="." />
    </device-transfer>
</data-extraction-rules>
